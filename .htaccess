# CT Custom Builders - static Hostinger website
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|svg|css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# Keep repository metadata out of the public website.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(?:/|$) - [F,L]
</IfModule>
